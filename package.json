{
  "name": "dsh-nextsteps",
  "version": "1.10.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./lib/locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "lib/host",
    "lib/locale",
    "docs/assets/icon.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.pt-BR.md",
    "README.zh-CN.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "description": "Suggested follow-up prompts for DeepSeek Harness chat: AI-generated next steps as clickable cards under every agent turn — one click sends the reply, zero typing. 15 languages.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "suggested-prompts",
    "follow-up",
    "followup",
    "prompt-suggestions",
    "next-steps",
    "quick-replies",
    "chat-ui",
    "chat-ux",
    "conversation",
    "productivity",
    "ai-chat",
    "ai-agent",
    "llm",
    "i18n",
    "multilingual",
    "ui-experience"
  ],
  "license": "MIT",
  "homepage": "https://github.com/klaus-2/dsh-nextsteps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaus-2/dsh-nextsteps.git"
  },
  "bugs": {
    "url": "https://github.com/klaus-2/dsh-nextsteps/issues"
  },
  "scripts": {
    "test": "node tools/regression.mjs && node scripts/test.mjs",
    "regression": "node tools/regression.mjs",
    "test:unit": "node scripts/test.mjs",
    "test:coverage": "c8 --include index.js --include lib/host/generation-round.mjs --include lib/host/conversation-options.mjs --check-coverage --lines 81 --functions 79 --reporter=text node scripts/test.mjs"
  },
  "icon": "./docs/assets/icon.png",
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
