{
  "name": "dsh-nextsteps",
  "version": "1.3.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./lib/locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/locale",
    "docs/assets/icon.png",
    "README.md",
    "LICENSE",
    "README.pt-BR.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "description": "Suggested next-step prompts under every finished agent turn in the DeepSeek Harness chat — one click sends the followup.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "followups",
    "next-steps",
    "suggestions",
    "ai-agents",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "homepage": "https://github.com/klaus-2/dsh-nextsteps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaus-2/dsh-nextsteps.git"
  },
  "bugs": {
    "url": "https://github.com/klaus-2/dsh-nextsteps/issues"
  },
  "icon": "./docs/assets/icon.png"
}
